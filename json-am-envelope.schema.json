{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON-AM Envelope",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/MemoryRecord"},
    {"$ref": "#/$defs/ContextEnvelope"},
    {"$ref": "#/$defs/ReasoningTrace"},
    {"$ref": "#/$defs/ATIR"}
  ],
  "$defs": {
    "BaseEnvelope": {
      "type": "object",
      "required": ["@context","id","type","uriScheme","trustDomain","version","issuedAt","provenance"],
      "properties": {
        "@context": {"const": "https://json-am.org/context/v0.1"},
        "id": {"type": "string", "format": "uri"},
        "type": {"type": "string"},
        "uriScheme": {"enum": ["memory","context","trace","agent","trust"]},
        "trustDomain": {"type": "string"},
        "version": {"type": "string"},
        "issuedAt": {"type": "string", "format": "date-time"},
        "provenance": {"type": "object"},
        "signature": {"type": "object"}
      }
    },
    "MemoryRecord": {
      "allOf": [{"$ref": "#/$defs/BaseEnvelope"}],
      "properties": {
        "type": {"const": "Memory"},
        "memoryKind": {"enum": ["episodic","semantic","skill"]},
        "content": {"type": "object"},
        "links": {"type": "array"}
      },
      "required": ["memoryKind","content"]
    },
    "ContextEnvelope": {
      "allOf": [{"$ref": "#/$defs/BaseEnvelope"}],
      "properties": {
        "type": {"const": "Context"},
        "contextKind": {"enum": ["session","project","trust"]},
        "scope": {"type": "string"},
        "includes": {"type": "array"}
      }
    },
    "ReasoningTrace": {
      "allOf": [{"$ref": "#/$defs/BaseEnvelope"}],
      "properties": {
        "type": {"const": "ReasoningTrace"},
        "runId": {"type": "string"},
        "steps": {"type": "array"}
      }
    },
    "ATIR": {
      "allOf": [{"$ref": "#/$defs/BaseEnvelope"}],
      "properties": {
        "type": {"const": "ATIR"},
        "task": {"type": "string"},
        "boundContext": {"type": "array"},
        "memoryLinks": {"type": "array"},
        "replayable": {"type": "boolean"}
      }
    }
  }
}
